#!/usr/bin/env python3
"""Preview-first rugby ICS export from authoritative PVR MongoDB episodes.

This is the *consumer*, not a scheduler. Fixture fetch, numbering, and NFOs
belong in mbligh/pvr/schedulers/. Existing docs/*.ics snapshots are merged
using the repository's established freeze-at-kickoff policy.

Run on an Atlas-allowed host (slagg), never expose Atlas to hosted runners:
    python3 build_rugby_calendars --series rugby-mens-intl
    python3 build_rugby_calendars --series rugby-mens-intl --apply
"""
import argparse
import copy
import datetime as dt
import json
import os
import pathlib
import re
import sys
import tempfile
import subprocess
from zoneinfo import ZoneInfo

from icalendar import Calendar, Event
from filter import merge, events, read_existing

ROOT = pathlib.Path(__file__).resolve().parent
UTC = dt.timezone.utc
CANCELLED = {"cancelled", "canceled"}
SUPERSEDED = "superseded"
INTL = "rugby-womens-intl"
WXV = "rugby-womens-wxv"
UID_BAD = re.compile(r"[\r\n\x00]")
DEFAULT_SECONDS = 2 * 60 * 60


def uid_for(episode, series):
    value = episode.get("_id")
    if not isinstance(value, str) or not value.startswith(series + ":"):
        raise ValueError(f"Episode does not belong to {series}: {value!r}")
    uid = value[len(series) + 1:]
    if not uid or len(uid) > 255 or UID_BAD.search(uid):
        raise ValueError("Unsafe or empty calendar event UID")
    return uid


def start_for(episode):
    scheduled = episode.get("scheduled")
    if isinstance(scheduled, dt.datetime):
        # PyMongo's default decoder returns naive *UTC* datetimes.
        return scheduled if scheduled.tzinfo else scheduled.replace(tzinfo=UTC)
    scheduled_date = episode.get("scheduled_date")
    if isinstance(scheduled_date, str):
        try:
            return dt.date.fromisoformat(scheduled_date)
        except ValueError as exc:
            raise ValueError(f"Invalid scheduled_date: {scheduled_date}") from exc
    raise ValueError(f"Fixture {episode.get('_id')} lacks a schedule")


def safe_text(value, field):
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"Missing {field} in authoritative fixture")
    # Never copy raw external descriptions, score/result data, or HTML.
    if UID_BAD.search(value):
        raise ValueError(f"Unexpected control character in {field}")
    return value.strip()


def event_from_episode(ep, series):
    uid = uid_for(ep, series)
    home = safe_text(ep.get("home"), "home team")
    away = safe_text(ep.get("away"), "away team")
    start = start_for(ep)
    component = Event()
    component.add("uid", uid)
    component.add("summary", f"{home} vs {away}")
    component.add("dtstart", start)
    if isinstance(start, dt.datetime):
        end = ep.get("scheduled_end")
        if isinstance(end, dt.datetime):
            end = end if end.tzinfo else end.replace(tzinfo=UTC)
        else:
            end = start + dt.timedelta(seconds=DEFAULT_SECONDS)
        if end <= start:
            raise ValueError(f"Invalid fixture end for {uid}")
    else:
        end = start + dt.timedelta(days=1)
    component.add("dtend", end)
    description = ["Spoiler-free rugby fixture"]
    round_no = ep.get("round")
    if type(round_no) is int and round_no > 0:
        description.append(f"Round {round_no}")
    component.add("description", ". ".join(description))
    if ep.get("venue"):
        component.add("location", safe_text(ep["venue"], "venue"))
    component.add("status", "CONFIRMED")
    return component


def build_source(records, series):
    calendar = Calendar()
    calendar.add("prodid", "-//mbligh/calendar//Atlas rugby feed//EN")
    calendar.add("version", "2.0")
    seen = set()
    valid = 0
    cancelled = 0
    superseded = 0
    skipped_unscheduled = 0
    for ep in records:
        uid = uid_for(ep, series)
        if uid in seen:
            raise ValueError(f"Duplicate authoritative UID in {series}: {uid}")
        seen.add(uid)
        if str(ep.get("status", "")).lower() == SUPERSEDED:
            superseded += 1
            continue
        if str(ep.get("status", "")).lower() in CANCELLED:
            calendar.add("x-wr-cancelled-uid", uid)
            cancelled += 1
            continue
        try:
            component = event_from_episode(ep, series)
        except ValueError as exc:
            if "lacks a schedule" not in str(exc):
                raise
            # TBC fixtures must not acquire invented dates. Existing
            # previously published entries are retained by filter.merge.
            skipped_unscheduled += 1
            continue
        calendar.add_component(component)
        valid += 1
    if not valid and not cancelled:
        raise ValueError(f"Refusing empty Atlas source for {series}")
    return calendar, {"source_fixtures": valid, "explicit_cancellations": cancelled,
                      "superseded": superseded,
                      "skipped_unscheduled": skipped_unscheduled}


def wxv_legacy_event(event):
    """Only migrate events whose frozen original description says WXV."""
    return event.name == "VEVENT" and str(event.get("DESCRIPTION", "")).strip().upper().startswith("WXV ")


def split_published_wxv(previous_intl, previous_wxv, wxv_rows):
    """Move frozen WXV events across feeds, maintaining original calendar UIDs.

    This is an explicit migration. Never drop a past event unless a corresponding
    WXV Atlas episode exists. Existing WXV output takes precedence.
    """
    if previous_intl is None:
        return previous_intl, previous_wxv, 0
    old_events = [e for e in previous_intl.walk("VEVENT") if wxv_legacy_event(e)]
    if not old_events:
        return previous_intl, previous_wxv, 0
    valid = {uid_for(ep, WXV) for ep in wxv_rows
             if str(ep.get("status", "")).lower() not in CANCELLED | {SUPERSEDED}}
    uids = [str(event.get("UID", "")).strip() for event in old_events]
    if len(set(uids)) != len(uids):
        raise ValueError("Duplicate WXV UIDs in published women's internationals")
    missing = set(uids) - valid
    if missing:
        raise ValueError("Cannot migrate WXV calendar: missing authoritative Atlas fixtures: "
                         + ", ".join(sorted(missing)[:5]))
    intl = copy.deepcopy(previous_intl)
    intl.subcomponents = [
        part for part in intl.subcomponents
        if not (part.name == "VEVENT" and wxv_legacy_event(part))
    ]
    if previous_wxv is not None:
        wxv = copy.deepcopy(previous_wxv)
    else:
        wxv = Calendar()
        wxv.add("version", "2.0")
        wxv.add("prodid", "-//mbligh/calendar//WXV migrated history//EN")
    existing = {str(e.get("UID", "")).strip() for e in wxv.walk("VEVENT")}
    for event in old_events:
        uid = str(event.get("UID", "")).strip()
        if uid not in existing:
            wxv.add_component(copy.deepcopy(event))
    return intl, wxv, len(old_events)


def plan(database, config, output_dir, *, series=None, now=None):
    """Build a complete, read-only plan; no directory creation or writes."""
    now = now or dt.datetime.now(UTC)
    if now.tzinfo is None:
        raise ValueError("now must include a timezone")
    zone = ZoneInfo(config.get("timezone", "UTC"))
    entries = {item["slug"]: item for item in config["calendars"]}
    selected = list(dict.fromkeys(series or entries))
    if not selected or any(s not in entries for s in selected):
        raise ValueError("Unknown/empty calendar series selection")
    # Validate all source collections first and prepare cross-calendar
    # migration before writing a single file.
    rows_by_series = {}
    for slug in selected:
        rows_by_series[slug] = list(database.episodes.find({"series_id": slug}))
        if not rows_by_series[slug]:
            raise ValueError(f"No Atlas fixtures for {slug}; aborting all exports")
    previous_by_series = {
        slug: read_existing(pathlib.Path(output_dir) / f"{slug}.ics")
        for slug in selected
    }
    moved = 0
    # WXV was formerly published in Rugby Womens Intl. Both feeds must
    # migrate together so no frozen historical fixture disappears.
    old_intl = read_existing(pathlib.Path(output_dir) / (INTL + ".ics"))
    if (set(selected) & {INTL, WXV}) and old_intl is not None and any(
            wxv_legacy_event(ev) for ev in old_intl.walk("VEVENT")):
        if INTL not in selected or WXV not in selected:
            raise ValueError("WXV split requires exporting rugby-womens-intl and rugby-womens-wxv together")
        previous_by_series[INTL], previous_by_series[WXV], moved = split_published_wxv(
            previous_by_series[INTL], previous_by_series[WXV],
            rows_by_series[WXV])
    plans = []
    for slug in selected:
        entry = entries[slug]
        source, info = build_source(rows_by_series[slug], slug)
        path = pathlib.Path(output_dir) / f"{slug}.ics"
        previous = previous_by_series[slug]
        disk_previous = read_existing(path)
        # This is exactly the old merge policy: no new past fixtures,
        # freeze all past accepted events; remove only explicit cancellations.
        merged = merge(source, previous, now, zone, entry["name"])
        after = events(merged)
        if not after:
            raise ValueError(f"Refusing empty published calendar: {slug}")
        prior = events(previous) if previous else {}
        original = events(disk_previous) if disk_previous else {}
        # Detect loss, not merely changes in serialized layout.
        removed = set(prior) - set(after)
        flagged = source.get("x-wr-cancelled-uid", [])
        if not isinstance(flagged, list):
            flagged = [flagged]
        cancelled = {str(x) for x in flagged}
        if removed - {(uid, "") for uid in cancelled}:
            raise ValueError(f"Unexpected removal of prior events in {slug}")
        payload = merged.to_ical()
        plans.append({
            "series": slug, "path": path, "bytes": payload,
            "unchanged": path.is_file() and path.read_bytes() == payload,
            "published_events": len(after),
            "previous_events": len(original),
            "added": len(set(after) - set(original)),
            "removed_cancelled": len(removed),
            "migrated_wxv": moved if slug in (INTL, WXV) else 0,
            **info,
        })
    return plans


def write_plans(plans):
    """Stage and replace output snapshots; git publication is a separate step."""
    tempfiles = []
    try:
        for item in plans:
            path = item["path"]
            if item["unchanged"]:
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            with tempfile.NamedTemporaryFile(prefix=".atlas-rugby-",
                                             suffix=".ics", dir=path.parent,
                                             delete=False) as stage:
                stage.write(item["bytes"])
                stage.flush()
                os.fsync(stage.fileno())
                tempfiles.append((pathlib.Path(stage.name), path))
        for temp, target in tempfiles:
            os.replace(temp, target)
    finally:
        for temp, _ in tempfiles:
            temp.unlink(missing_ok=True)


def run(database, config, output_dir, *, series=None, apply=False,
        now=None, stream=sys.stdout):
    plans = plan(database, config, output_dir, series=series, now=now)
    if apply:
        write_plans(plans)
    for item in plans:
        report = {key: value for key, value in item.items()
                  if key not in ("bytes", "path")}
        report.update(mode="apply" if apply else "preview",
                      path=str(item["path"]))
        print(json.dumps(report, sort_keys=True), file=stream)
    return plans


def publish_to_git(plans, *, activate=False, execute=subprocess.run):
    """Commit only managed rugby ICS files, then push from an allowlisted host.

    Activation is an explicit handoff: GitHub Actions stops using the old
    rugby scrapers only once this marker has been committed with the
    complete Atlas-derived snapshots.
    """
    branch = execute(["git", "branch", "--show-current"], cwd=ROOT,
                     capture_output=True, text=True, check=True).stdout.strip()
    if branch != "main":
        raise ValueError("Publishing requires the calendar repository main branch")
    staged = [str(item["path"]) for item in plans]
    if activate:
        if len(plans) == 0:
            raise ValueError("Cannot activate an empty calendar publication")
        marker_file = ROOT / ".github" / "atlas-rugby-active"
        marker_file.write_text(
            "Atlas rugby calendars are published from slagg.\n"
            "The legacy GitHub Actions rugby fetcher is disabled.\n",
            encoding="utf-8")
        staged.append(str(marker_file))
    execute(["git", "add", "--", *staged], cwd=ROOT, check=True)
    diff = execute(["git", "diff", "--cached", "--quiet"], cwd=ROOT, check=False)
    if diff.returncode == 0:
        return "unchanged"
    if diff.returncode != 1:
        raise RuntimeError("Could not inspect staged rugby calendar changes")
    execute(["git", "commit", "-m", "Publish spoiler-free rugby calendars from Atlas"],
            cwd=ROOT, check=True)
    execute(["git", "push", "origin", "main"], cwd=ROOT, check=True)
    return "pushed"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=pathlib.Path, default=ROOT / "calendars.json")
    parser.add_argument("--output", type=pathlib.Path, default=ROOT / "docs")
    parser.add_argument("--series", action="append", help="Calendar slug; repeatable")
    parser.add_argument("--database", default=os.environ.get("MONGODB_DATABASE", "pvr"))
    parser.add_argument("--apply", action="store_true",
                        help="Write ICS snapshots (preview is the default)")
    parser.add_argument("--publish", action="store_true",
                        help="Commit and push only generated rugby ICS files to GitHub")
    parser.add_argument("--activate", action="store_true",
                        help="With --publish, commit the Atlas publisher cutover marker")
    args = parser.parse_args(argv)
    if args.publish and not args.apply:
        parser.error("--publish requires --apply")
    if args.activate and not (args.publish and args.apply and not args.series):
        parser.error("--activate requires --apply --publish for all configured series")
    try:
        if args.publish:
            # Pull before building, so we are merging against the latest
            # frozen published snapshots, not an outdated local checkout.
            subprocess.run(["git", "pull", "--ff-only", "origin", "main"],
                           cwd=ROOT, check=True)
        config = json.loads(args.config.read_text(encoding="utf-8"))
        uri = os.environ.get("MONGODB_URI")
        if not uri:
            uri = (pathlib.Path.home() / ".mongodb" / "pvr").read_text(
                encoding="utf-8").strip()
        if not uri:
            raise ValueError("Empty MongoDB Atlas connection URI")
        from pymongo import MongoClient
        with MongoClient(uri, serverSelectionTimeoutMS=15000) as client:
            client.admin.command("ping")
            plans = run(client[args.database], config, args.output,
                        series=args.series, apply=args.apply)
        if args.publish:
            result = publish_to_git(plans, activate=args.activate)
            print(json.dumps({"publication": result, "activated": args.activate}))
    except (OSError, ValueError, KeyError, TypeError,
            subprocess.CalledProcessError, RuntimeError) as exc:
        print(f"Build rugby calendars: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
